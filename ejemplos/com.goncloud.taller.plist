<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mantiene el daemon de taller siempre encendido. Instalar en ~/Library/LaunchAgents/ y
     cargar con: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.goncloud.taller.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.goncloud.taller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string><string>-m</string><string>taller</string>
    <string>daemon</string><string>--home</string><string>/Users/dn/.local/state/taller</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/dn/dev/goncloud-taller</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/dn/.local/state/taller/daemon.log</string>
  <key>StandardErrorPath</key><string>/Users/dn/.local/state/taller/daemon.log</string>
</dict>
</plist>
